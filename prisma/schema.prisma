generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// User (Admin Accounts) - MANTENIDO EN SQLITE LOCAL
// ==========================================
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String   // Contraseña encriptada (bcrypt)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// NOTA: Las tablas categories, products, quotes, quote_items
// ahora están en Supabase. Ver supabase-migrations/01-create-tables.sql
